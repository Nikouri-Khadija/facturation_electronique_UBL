<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bouton « Générer facture UBL » et accès à l'historique des fichiers XML -->
    <record id="view_move_form_facture_ubl" model="ir.ui.view">
        <field name="name">account.move.form.facture.ubl</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generer_facture_ubl"
                        type="object"
                        string="Générer facture UBL"
                        invisible="move_type != 'out_invoice' or state != 'posted'"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_voir_historique_ubl"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-code-o"
                        invisible="historique_ubl_count == 0">
                    <field name="historique_ubl_count" widget="statinfo" string="XML UBL"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
